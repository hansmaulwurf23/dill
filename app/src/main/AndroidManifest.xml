<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keine eigenen Berechtigungen nötig: der ML-Kit-Scanner bringt seine eigene Kamera-Activity
         mit, und der Export läuft über das Storage Access Framework. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dill">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BillDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Nur zum Anzeigen der eigenen PDFs in einem externen Betrachter. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="de.noisebleed.dill.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
